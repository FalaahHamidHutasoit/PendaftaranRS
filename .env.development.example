# Salin file ini menjadi .env di root proyek, lalu sesuaikan bila perlu.
# JANGAN commit file .env.
# Nilai di bawah ini HANYA contoh lokal, bukan kredensial.

CI_ENVIRONMENT = development

# Untuk php spark serve (cara akses utama), pakai baseURL ini.
# Bila memakai XAMPP lewat Apache, ubah ke alamat folder public/,
# contoh: app.baseURL = 'http://localhost/PendaftaranRS/public/'
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

database.default.hostname = localhost
database.default.database = pendaftaran_rs
database.default.username = root
# Kosongkan baris ini bila MySQL lokal Anda tanpa password
# (default XAMPP). Isi hanya bila MySQL lokal Anda memakai password.
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
